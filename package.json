{
  "name": "loomware",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generar-servicios.js && node scripts/recorridos.js",
    "build": "vite build && vite build --ssr src/prerender.jsx --outDir dist-ssr",
    "preview": "vite preview",
    "generar:servicios": "node scripts/generar-servicios.js",
    "share": "cloudflared tunnel --url http://localhost:5173",
    "optimizar:imagenes": "node scripts/optimizar-imagenes.js",
    "fuente:subconjunto": "node scripts/subconjunto-fuente.js",
    "generar:recorridos": "node scripts/recorridos.js",
    "fuente:mono": "node scripts/subconjunto-mono.js",
    "hero:dibujo": "node scripts/hero-dibujo.js",
    "og:imagen": "node scripts/og-imagen.js",
    "og:recorridos": "node scripts/og-recorridos.js",
    "og:paginas": "node scripts/og-paginas.js",
    "fuente:titulares": "node scripts/subconjunto-titulares.js",
    "fuente:recorridos": "node scripts/subconjunto-recorridos.js",
    "logo:cliente": "node scripts/logo-cliente.js",
    "prerender": "node scripts/prerender.js",
    "postbuild": "node scripts/prerender.js && node scripts/encabezados.js",
    "encabezados": "node scripts/encabezados.js",
    "recorridos:escenas": "node scripts/escenas.js",
    "hero:sistema": "node scripts/hero-sistema.js",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "sharp": "^0.35.4",
    "subset-font": "^2.9.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18"
  }
}
