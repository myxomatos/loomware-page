# Copia este archivo a .env y llena lo que necesites. Todas son opcionales.

# Endpoint que recibe el formulario de diagnóstico como JSON (POST).
# Ej. Formspree: https://formspree.io/f/xxxxxxxx  |  Web3Forms: https://api.web3forms.com/submit
# Si se deja vacío, el botón abre el cliente de correo con la solicitud prellenada.
VITE_FORM_ENDPOINT=

# Enlace de agenda (Calendly, Cal.com…) para el botón "Agendar ahora".
# Si se deja vacío, el botón lleva al formulario.
VITE_SCHEDULE_URL=
