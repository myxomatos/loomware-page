# Copia este archivo a .env y llena lo que necesites. Todas son opcionales.

# --- Formulario de diagnóstico ---
# Estas tres son SÓLO de Cloudflare (Settings -> Environment variables); en local
# la función no corre, así que aquí no hacen nada. Se listan como referencia.
#   RESEND_API_KEY  llave de https://resend.com  (guardar como Secret)
#   LEAD_TO         bandeja que recibe los leads (opcional)
#   LEAD_FROM       remitente verificado en Resend (opcional)

# Enlace de agenda (Calendly, Cal.com…) para el botón "Agendar ahora".
# Si se deja vacío, el botón lleva al formulario.
VITE_SCHEDULE_URL=

# --- Herramienta de prospección (/prospectar) ---
# Token de la API DENUE del INEGI. Se pide gratis con tu correo en:
# https://www.inegi.org.mx/servicios/api_denue.html  (botón "Obtener token")
# Sin prefijo VITE_: solo lo lee el servidor, nunca llega al navegador.
DENUE_TOKEN=

# Contraseña para entrar a /prospectar en el sitio publicado.
# En local (npm run dev) no se pide.
PROSPECT_KEY=

# --- Analítica (opcionales; sin ellas no se carga nada) ---
# ID de medición de Google Analytics 4, empieza con G-. Se inyecta en todas las
# páginas al compilar; /gracias y los clics a WhatsApp cuentan como conversión.
VITE_GA_ID=

# Código de verificación de Google Search Console (método "etiqueta HTML").
VITE_GSC_VERIFICATION=
